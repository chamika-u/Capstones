{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Times New Roman, Times, serif",
    "fontSize": "16px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "lineColor": "#000000",
    "textColor": "#000000",
    "tertiaryColor": "#f2f2f2",
    "tertiaryBorderColor": "#000000",
    "edgeLabelBackground": "#ffffff",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#000000"
  },
  "flowchart": {
    "useMaxWidth": false,
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 55,
    "rankSpacing": 80,
    "padding": 12
  },
  "er": {
    "useMaxWidth": false,
    "layoutDirection": "TB",
    "minEntityWidth": 120,
    "minEntityHeight": 80,
    "entityPadding": 18
  },
  "securityLevel": "loose"
}
