    USER ||--o{ EQUIPMENT_ALLOCATION : "borrows"
    USER ||--o{ AUDIT_LOG : "performs"
    USER ||--o{ NOTIFICATION : "receives"
    RESOURCE ||--o{ TIMETABLE_SLOT : "scheduled in"
    RESOURCE ||--o{ BOOKING : "reserved via"
    RESOURCE ||--o{ MAINTENANCE_BLACKOUT : "blocked by"
    RESOURCE ||--o{ EQUIPMENT_ALLOCATION : "issued as"
    RESOURCE ||--o{ RESOURCE_SOFTWARE : "equipped with"
    SOFTWARE ||--o{ RESOURCE_SOFTWARE : "installed on"
